# Copia este archivo como .env y rellena los valores reales
# NUNCA subas el .env al repositorio (ya está en .gitignore)

# Base de datos PostgreSQL
DB_HOST=localhost
DB_NAME=asistente_db
DB_USER=postgres
DB_PASS=tu_contraseña_aqui

# API de Google Gemini (opcional, no se usa actualmente)
GEMINI_API_KEY=tu_api_key_aqui

# Modelo de Ollama a usar (por defecto: llama3)
OLLAMA_MODEL=llama3

# Voz de Frank (edge-tts). Ejecuta probar_voces.py para escuchar opciones.
# Masculina Perú: es-PE-AlexNeural | Femenina Perú: es-PE-CamilaNeural
FRANK_VOZ=es-PE-AlexNeural

# ID del usuario y dispositivo en la base de datos
USUARIO_ID=1
DISPOSITIVO_ID=1
